<!DOCTYPE html>
<html lang="en">
<head>
<base href="./">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Civil Engineer — Remote Estimating</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --black:#000000;
    --white:#ffffff;
    --grey:#6b6b6b;
    --line-on-black:rgba(255,255,255,0.18);
    --line-on-white:rgba(0,0,0,0.18);
    --ease:cubic-bezier(.16,.8,.28,1);
  }

  *{margin:0;padding:0;box-sizing:border-box;}

  html,body{
    height:100%;
    background:var(--black);
  }

  body{
    font-family:'Inter',sans-serif;
    color:var(--white);
    -webkit-font-smoothing:antialiased;
  }

  .display{
    font-family:'Space Grotesk',sans-serif;
    letter-spacing:-0.02em;
  }

  /* ---------- scroll frame ---------- */
  #frame{
    height:100vh;
    overflow-y:scroll;
    scroll-snap-type:y mandatory;
    scroll-behavior:smooth;
  }
  @media (prefers-reduced-motion: reduce){
    #frame{scroll-behavior:auto;}
  }

  section.page{
    position:relative;
    min-height:100vh;
    scroll-snap-align:start;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:0 7vw;
    overflow:hidden;
  }

  .on-black{background:var(--black); color:var(--white);}
  .on-white{background:var(--white); color:var(--black);}

  .label{
    font-size:0.72rem;
    letter-spacing:0.14em;
    text-transform:uppercase;
    font-weight:500;
  }

  .muted{color:var(--grey);}

  hr.rule{
    border:none;
    height:1px;
    background:var(--line-on-black);
    width:100%;
  }
  .on-white hr.rule{background:var(--line-on-white);}

  /* ---------- top nav ---------- */
  #nav{
    position:fixed;
    top:0; left:0; right:0;
    z-index:50;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:2.2rem 7vw 0;
    pointer-events:none;
    mix-blend-mode:difference;
  }
  #nav *{pointer-events:auto;}

  .mark{
    font-family:'Space Grotesk',sans-serif;
    font-size:0.95rem;
    font-weight:600;
    color:var(--white);
  }

  #nav ul{
    list-style:none;
    display:flex;
    gap:2.4rem;
  }
  #nav a{
    color:var(--white);
    text-decoration:none;
    font-size:0.72rem;
    letter-spacing:0.12em;
    text-transform:uppercase;
    opacity:0.55;
    transition:opacity .3s var(--ease);
  }
  #nav a:hover, #nav a:focus-visible, #nav a.active{opacity:1;}

  #navToggle{display:none;}

  /* ---------- page counter ---------- */
  #counter{
    position:fixed;
    bottom:2.2rem;
    right:7vw;
    z-index:50;
    font-family:'Space Grotesk',sans-serif;
    font-variant-numeric:tabular-nums;
    font-size:0.75rem;
    color:var(--white);
    mix-blend-mode:difference;
  }

  /* ================= COVER ================= */
  #cover{
    align-items:center;
    text-align:center;
    background:
      linear-gradient(var(--black),var(--black)),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 64px);
  }
  #cover .cover-head{
    font-size:clamp(3.2rem, 11vw, 8.5rem);
    font-weight:600;
    line-height:0.95;
  }
  #cover .cover-sub{
    margin-top:1.2rem;
    font-size:clamp(1.1rem, 3vw, 1.7rem);
    font-weight:400;
    color:var(--grey);
  }
  #cover .cover-tag{
    margin-top:2.6rem;
    font-size:0.78rem;
    letter-spacing:0.18em;
  }
  #cover .scroll-cue{
    position:absolute;
    bottom:3rem; left:50%;
    transform:translateX(-50%);
    width:1px; height:44px;
    background:var(--line-on-black);
  }
  #cover .scroll-cue::after{
    content:'';
    position:absolute;
    top:0; left:-2px;
    width:5px; height:5px;
    border-radius:50%;
    background:var(--white);
    animation:drip 2.2s var(--ease) infinite;
  }
  @keyframes drip{
    0%{top:0; opacity:1;}
    80%{top:38px; opacity:0;}
    100%{top:38px; opacity:0;}
  }
  @media (prefers-reduced-motion: reduce){
    #cover .scroll-cue::after{animation:none; top:38px; opacity:0.6;}
  }

  /* ================= INTRO ================= */
  #intro{
    align-items:flex-start;
  }
  #intro .intro-text{
    max-width:20ch;
    font-size:clamp(1.8rem, 4.4vw, 3.4rem);
    font-weight:500;
    line-height:1.15;
  }
  #intro .intro-text em{
    font-style:normal;
    color:var(--grey);
  }
  #intro .index-mark{
    position:absolute;
    top:2.4rem; right:7vw;
    font-family:'Space Grotesk',sans-serif;
    font-size:0.78rem;
    color:var(--grey);
  }

  /* ================= ABOUT ================= */
  #about{
    align-items:flex-end;
  }
  #about .col{
    max-width:44ch;
    text-align:right;
  }
  #about .label{margin-bottom:1.6rem;}
  #about p{
    font-size:clamp(1.3rem, 2.6vw, 1.9rem);
    font-weight:400;
    line-height:1.5;
  }

  /* ================= ESTIMATING ================= */
  #estimating{
    align-items:center;
    text-align:center;
  }
  #estimating .frame{
    position:absolute;
    inset:3.4rem 7vw;
    pointer-events:none;
  }
  #estimating .corner{
    position:absolute;
    width:22px; height:22px;
  }
  #estimating .corner::before,
  #estimating .corner::after{
    content:'';
    position:absolute;
    background:var(--line-on-black);
  }
  #estimating .corner::before{width:100%; height:1px; top:50%;}
  #estimating .corner::after{height:100%; width:1px; left:50%;}
  #estimating .tl{top:0; left:0;}
  #estimating .tr{top:0; right:0;}
  #estimating .bl{bottom:0; left:0;}
  #estimating .br{bottom:0; right:0;}

  #estimating .label{margin-bottom:1.4rem;}
  #estimating .eq{
    font-size:clamp(1.7rem, 5vw, 3.6rem);
    font-weight:600;
    line-height:1.2;
  }

  /* ================= WORK ================= */
  #work{
    justify-content:flex-start;
    padding-top:9rem;
    padding-bottom:5rem;
  }
  #work .head-row{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-bottom:3rem;
  }
  #work h2{
    font-size:clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight:600;
  }
  .slots{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:1.5px;
    background:var(--line-on-white);
    flex:1;
  }
  .slot{
    background:var(--white);
    aspect-ratio:3/4;
    position:relative;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    padding:1.2rem;
    cursor:pointer;
    border:none;
    text-align:left;
    font:inherit;
    color:inherit;
    -webkit-appearance:none;
    appearance:none;
    transition:background .35s var(--ease);
  }
  .slot::before{
    content:'';
    position:absolute;
    inset:1.2rem;
    background-image:
      linear-gradient(var(--line-on-white) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-on-white) 1px, transparent 1px);
    background-size:100% 25%, 33.33% 100%;
    opacity:0.55;
    transition:opacity .35s var(--ease);
  }
  .slot:hover, .slot:focus-visible{background:#f4f4f4;}
  .slot:hover::before, .slot:focus-visible::before{opacity:0.85;}
  .slot .slot-top{
    position:relative;
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
  }
  .slot .slot-num{
    font-family:'Space Grotesk',sans-serif;
    font-size:0.75rem;
    letter-spacing:0.1em;
    color:var(--grey);
  }
  .slot .slot-expand{
    position:relative;
    width:22px; height:22px;
    border:1px solid var(--line-on-white);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:0.7rem;
    color:var(--grey);
    transition:transform .35s var(--ease), background .35s var(--ease), color .35s var(--ease);
  }
  .slot:hover .slot-expand{
    background:var(--black);
    color:var(--white);
    transform:rotate(45deg);
  }
  .slot .slot-title{
    position:relative;
    font-family:'Space Grotesk',sans-serif;
    font-size:0.95rem;
    font-weight:600;
  }
  .slot .slot-sub{
    position:relative;
    font-size:0.72rem;
    color:var(--grey);
    margin-top:0.2rem;
  }
  @media (max-width:720px){
    .slots{grid-template-columns:1fr;}
  }

  /* ---------- lightbox / detail viewer ---------- */
  #lightbox{
    position:fixed;
    inset:0;
    z-index:100;
    background:var(--white);
    color:var(--black);
    display:flex;
    opacity:0;
    visibility:hidden;
    transform:translateY(12px);
    transition:opacity .4s var(--ease), transform .4s var(--ease), visibility 0s linear .4s;
  }
  #lightbox.open{
    opacity:1;
    visibility:visible;
    transform:translateY(0);
    transition:opacity .4s var(--ease), transform .4s var(--ease), visibility 0s linear 0s;
  }
  @media (prefers-reduced-motion: reduce){
    #lightbox{transition:opacity .15s linear, visibility 0s linear;}
  }
  #lightbox .lb-close{
    position:absolute;
    top:2rem; right:7vw;
    z-index:5;
    background:none;
    border:none;
    font-family:'Space Grotesk',sans-serif;
    font-size:0.78rem;
    letter-spacing:0.12em;
    text-transform:uppercase;
    cursor:pointer;
    color:var(--black);
    display:flex;
    align-items:center;
    gap:0.6rem;
  }
  #lightbox .lb-close::after{
    content:'\2715';
    font-size:0.7rem;
  }
  #lightbox .lb-canvas{
    flex:1.4;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
      repeating-linear-gradient(0deg, rgba(0,0,0,0.05) 0 1px, transparent 1px 48px),
      repeating-linear-gradient(90deg, rgba(0,0,0,0.05) 0 1px, transparent 1px 48px);
    border-right:1px solid var(--line-on-white);
  }
  #lightbox .lb-canvas .lb-placeholder{
    width:70%;
    aspect-ratio:4/3;
    border:1px dashed var(--line-on-white);
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:2rem;
  }
  #lightbox .lb-canvas .lb-placeholder p{
    font-size:0.78rem;
    color:var(--grey);
    max-width:26ch;
    line-height:1.5;
  }
  #lightbox .lb-panel{
    flex:1;
    padding:7rem 3.5vw 3rem;
    display:flex;
    flex-direction:column;
    overflow-y:auto;
  }
  #lightbox .lb-panel .lb-index{
    font-family:'Space Grotesk',sans-serif;
    font-size:0.78rem;
    color:var(--grey);
    margin-bottom:1.4rem;
  }
  #lightbox .lb-panel h3{
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight:600;
    margin-bottom:0.4rem;
  }
  #lightbox .lb-panel .lb-kicker{
    font-size:0.72rem;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--grey);
    margin-bottom:2.4rem;
  }
  #lightbox .lb-fields{
    display:flex;
    flex-direction:column;
    margin-top:auto;
    padding-top:2rem;
  }
  #lightbox .lb-field{
    display:flex;
    justify-content:space-between;
    gap:1.5rem;
    padding:1rem 0;
    border-top:1px solid var(--line-on-white);
    font-size:0.85rem;
  }
  #lightbox .lb-field:last-child{border-bottom:1px solid var(--line-on-white);}
  #lightbox .lb-field .lb-label{
    color:var(--grey);
    letter-spacing:0.06em;
    text-transform:uppercase;
    font-size:0.7rem;
    white-space:nowrap;
    padding-top:0.15rem;
  }
  #lightbox .lb-field .lb-value{
    text-align:right;
    color:var(--grey);
  }
  #lightbox .lb-nav{
    position:absolute;
    bottom:2.4rem; left:0; right:0;
    display:flex;
    justify-content:center;
    gap:2.5rem;
    z-index:5;
  }
  #lightbox .lb-nav button{
    background:none;
    border:none;
    font-family:'Space Grotesk',sans-serif;
    font-size:0.72rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--grey);
    cursor:pointer;
    transition:color .3s var(--ease);
  }
  #lightbox .lb-nav button:hover, #lightbox .lb-nav button:focus-visible{color:var(--black);}

  @media (max-width:820px){
    #lightbox{flex-direction:column; overflow-y:auto;}
    #lightbox .lb-canvas{border-right:none; border-bottom:1px solid var(--line-on-white); min-height:45vh;}
    #lightbox .lb-panel{padding:6rem 6vw 8rem;}
  }

  /* ================= PROCESS ================= */
  #process .steps{
    margin-top:3rem;
    display:flex;
    flex-direction:column;
  }
  #process .step{
    display:flex;
    align-items:center;
    gap:2.4rem;
    padding:2.2rem 0;
    border-top:1px solid var(--line-on-black);
  }
  #process .step:last-child{border-bottom:1px solid var(--line-on-black);}
  #process .step .num{
    font-family:'Space Grotesk',sans-serif;
    font-size:0.85rem;
    color:var(--grey);
    width:2.5rem;
    flex-shrink:0;
  }
  #process .step .fill{
    flex:1;
    height:1px;
    background:var(--line-on-black);
    opacity:0.5;
  }

  /* ================= MARKETS ================= */
  .market{
    align-items:center;
    text-align:center;
  }
  .market .country{
    font-size:clamp(4rem, 18vw, 13rem);
    font-weight:700;
    line-height:0.9;
  }
  .market .sub{
    margin-top:1.4rem;
    font-size:0.8rem;
    letter-spacing:0.16em;
    color:var(--grey);
  }

  /* ================= CLOSING ================= */
  #closing{
    align-items:center;
    text-align:center;
  }
  #closing .close-head{
    font-size:clamp(2.4rem, 6vw, 4.5rem);
    font-weight:600;
    line-height:1.05;
  }
  #closing .close-sub{
    margin-top:0.8rem;
    font-size:clamp(1rem, 2.2vw, 1.3rem);
    color:var(--grey);
    font-weight:400;
  }
  #closing .close-tag{
    margin-top:2rem;
    font-size:0.78rem;
    letter-spacing:0.16em;
  }
  #closing .contact{
    margin-top:4.5rem;
    width:100%;
    max-width:420px;
  }
  #closing .contact .field{
    display:flex;
    justify-content:space-between;
    padding:0.9rem 0;
    border-bottom:1px solid var(--line-on-black);
    font-size:0.85rem;
  }
  #closing .contact .field .label{color:var(--grey);}

  /* ---------- responsive ---------- */
  @media (max-width:640px){
    #nav ul{gap:1.4rem;}
    #nav a{font-size:0.62rem;}
    section.page{padding:0 6vw;}
    #about{align-items:flex-start; text-align:left;}
    #about .col{text-align:left;}
  }
</style>
</head>
<body>

<nav id="nav">
  <span class="mark">C.E.</span>
  <ul id="navLinks">
    <li><a href="#about" data-target="about">About</a></li>
    <li><a href="#estimating" data-target="estimating">Estimating</a></li>
    <li><a href="#work" data-target="work">Work</a></li>
    <li><a href="#process" data-target="process">Process</a></li>
    <li><a href="#closing" data-target="closing">Contact</a></li>
  </ul>
</nav>

<div id="counter"><span id="counterCurrent">01</span> / 09</div>

<div id="frame">

  <section class="page on-black" id="cover">
    <h1 class="display cover-head">CIVIL<br>ENGINEER</h1>
    <p class="cover-sub">Remote Estimating</p>
    <p class="label cover-tag">AUSTRALIA · USA</p>
    <div class="scroll-cue"></div>
  </section>

  <section class="page on-white" id="intro">
    <span class="index-mark">02</span>
    <p class="display intro-text">
      Civil engineer.<br>
      Remote estimating<br>
      for <em>Australian &amp;<br>US</em> clients.
    </p>
  </section>

  <section class="page on-black" id="about">
    <div class="col">
      <p class="label">About</p>
      <p>Civil engineer focused on remote estimating for Australian and US clients.</p>
    </div>
  </section>

  <section class="page on-white" id="estimating">
    <div class="frame">
      <span class="corner tl"></span>
      <span class="corner tr"></span>
      <span class="corner bl"></span>
      <span class="corner br"></span>
    </div>
    <p class="label">Remote Estimating</p>
    <p class="display eq">CIVIL ENGINEERING<br>×<br>REMOTE ESTIMATING</p>
  </section>

  <section class="page on-white" id="work">
    <div class="head-row">
      <h2 class="display">Sample Takeoffs</h2>
      <span class="label muted">Practice Estimating Work</span>
    </div>
    <div class="slots">
      <button class="slot" data-sample="0"><span class="slot-top"><span class="slot-num">01</span><span class="slot-expand">+</span></span><span><span class="slot-title">Takeoff 01</span><span class="slot-sub">Add title on upload</span></span></button>
      <button class="slot" data-sample="1"><span class="slot-top"><span class="slot-num">02</span><span class="slot-expand">+</span></span><span><span class="slot-title">Takeoff 02</span><span class="slot-sub">Add title on upload</span></span></button>
      <button class="slot" data-sample="2"><span class="slot-top"><span class="slot-num">03</span><span class="slot-expand">+</span></span><span><span class="slot-title">Takeoff 03</span><span class="slot-sub">Add title on upload</span></span></button>
    </div>
  </section>

  <section class="page on-black" id="process">
    <p class="label">Process</p>
    <div class="steps">
      <div class="step"><span class="num">01</span><span class="fill"></span></div>
      <div class="step"><span class="num">02</span><span class="fill"></span></div>
      <div class="step"><span class="num">03</span><span class="fill"></span></div>
    </div>
  </section>

  <section class="page on-black market" id="australia">
    <p class="display country">AUSTRALIA</p>
    <p class="sub">Target Market — 01</p>
  </section>

  <section class="page on-white market" id="usa" style="color:#000;">
    <p class="display country">USA</p>
    <p class="sub">Target Market — 02</p>
  </section>

  <section class="page on-black" id="closing">
    <p class="display close-head">CIVIL ENGINEER</p>
    <p class="close-sub">Remote Estimating</p>
    <p class="label close-tag">AUSTRALIA · USA</p>
    <div class="contact">
      <div class="field"><span class="label">Email</span><span>—</span></div>
      <div class="field"><span class="label">LinkedIn</span><span>—</span></div>
    </div>
  </section>

</div>

<div id="lightbox" role="dialog" aria-modal="true" aria-label="Sample takeoff detail">
  <button class="lb-close">Close</button>
  <div class="lb-canvas">
    <div class="lb-placeholder">
      <p>Drop the takeoff drawing, marked-up PDF, or screenshot for this sample here.</p>
    </div>
  </div>
  <div class="lb-panel">
    <p class="lb-index" id="lbIndex">01 / 03</p>
    <h3 id="lbTitle">Takeoff 01</h3>
    <p class="lb-kicker">Practice Estimating Work</p>
    <div class="lb-fields">
      <div class="lb-field"><span class="lb-label">Scope</span><span class="lb-value">—</span></div>
      <div class="lb-field"><span class="lb-label">Quantity Type</span><span class="lb-value">—</span></div>
      <div class="lb-field"><span class="lb-label">Method</span><span class="lb-value">—</span></div>
      <div class="lb-field"><span class="lb-label">Software</span><span class="lb-value">—</span></div>
      <div class="lb-field"><span class="lb-label">Notes</span><span class="lb-value">—</span></div>
    </div>
  </div>
  <div class="lb-nav">
    <button id="lbPrev">← Previous</button>
    <button id="lbNext">Next →</button>
  </div>
</div>

<script>
  const sections = Array.from(document.querySelectorAll('section.page'));
  const navLinks = Array.from(document.querySelectorAll('#navLinks a'));
  const counter = document.getElementById('counterCurrent');

  const io = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        const idx = sections.indexOf(entry.target) + 1;
        counter.textContent = String(idx).padStart(2,'0');
        navLinks.forEach(a=>a.classList.remove('active'));
        const match = navLinks.find(a=>a.dataset.target===entry.target.id);
        if(match) match.classList.add('active');
      }
    });
  }, { root:document.getElementById('frame'), threshold:0.6 });

  sections.forEach(s=>io.observe(s));

  navLinks.forEach(a=>{
    a.addEventListener('click', e=>{
      e.preventDefault();
      document.getElementById(a.dataset.target).scrollIntoView({behavior:'smooth', block:'start'});
    });
  });

  /* ---------- lightbox ---------- */
  const lightbox = document.getElementById('lightbox');
  const slots = Array.from(document.querySelectorAll('.slot'));
  const lbIndex = document.getElementById('lbIndex');
  const lbTitle = document.getElementById('lbTitle');
  const lbClose = document.querySelector('.lb-close');
  const lbPrev = document.getElementById('lbPrev');
  const lbNext = document.getElementById('lbNext');
  let currentSample = 0;
  const total = slots.length;

  function renderSample(i){
    currentSample = (i + total) % total;
    lbIndex.textContent = String(currentSample+1).padStart(2,'0') + ' / ' + String(total).padStart(2,'0');
    lbTitle.textContent = 'Takeoff ' + String(currentSample+1).padStart(2,'0');
  }

  function openLightbox(i){
    renderSample(i);
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function closeLightbox(){
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  slots.forEach(slot=>{
    slot.addEventListener('click', ()=> openLightbox(parseInt(slot.dataset.sample, 10)));
  });

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', ()=> renderSample(currentSample - 1));
  lbNext.addEventListener('click', ()=> renderSample(currentSample + 1));

  document.addEventListener('keydown', e=>{
    if(!lightbox.classList.contains('open')) return;
    if(e.key === 'Escape') closeLightbox();
    if(e.key === 'ArrowLeft') renderSample(currentSample - 1);
    if(e.key === 'ArrowRight') renderSample(currentSample + 1);
  });
</script>

</body>
</html>
